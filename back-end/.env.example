# =============================================
# SERVER CONFIGURATION
# =============================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# =============================================
# DATABASE
# =============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptabilite?schema=public"

# =============================================
# AUTHENTICATION (Better Auth)
# =============================================
# Secret key for encrypting cookies and tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-change-this-in-production

# Base URL where the backend API is hosted
BETTER_AUTH_BASE_URL=http://localhost:3001

# =============================================
# CORS & FRONTEND
# =============================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# =============================================
# OAUTH PROVIDERS (Optional)
# =============================================
# Google OAuth credentials (optional)
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================
# FEATURE FLAGS
# =============================================
# Enable rate limiting (recommended for production)
ENABLE_RATE_LIMIT=true

# =============================================
# WEB PUSH (VAPID) - Notifications navigateur
# =============================================
# Generate keys with: npx web-push generate-vapid-keys --json
# Public key exposed to the frontend; private key stays server-side only
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact for the push service (must be a mailto: URL)
# WEB_PUSH_SUBJECT=mailto:admin@wonderful.local

# =============================================
# EMAIL CONFIGURATION (Future)
# =============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@formalites-pro.com

# =============================================
# PAYMENT CONFIGURATION (Future)
# =============================================
# Stripe keys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================
# STORAGE CONFIGURATION
# =============================================
# Local storage path for documents
STORAGE_PATH=./storage/documents

# =============================================
# REDIS CONFIGURATION (Future for caching/sessions)
# =============================================
# REDIS_URL=redis://localhost:6379

